# Port server API
PORT=3000

# Connection string PostgreSQL (Neon / Supabase / lokal)
# Contoh Neon: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/batur?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batur

# Gateway AI (OpenAI-compatible) untuk mode cloud. Kosongkan untuk pakai fallback aturan.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=
