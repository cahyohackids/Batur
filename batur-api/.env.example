# Port dan alamat server API. Default 127.0.0.1 (di belakang Nginx).
# Untuk uji dari HP di Wi-Fi yang sama, isi HOST=0.0.0.0.
PORT=3000
HOST=127.0.0.1

# Connection string PostgreSQL (lokal, Docker, Neon, atau Supabase)
# Contoh Neon: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/batur?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batur

# Gateway AI (OpenAI-compatible) untuk mode cloud. Kosongkan untuk pakai rule parser.
# Model dikunci di sini; aplikasi tidak bisa memilih model dan tidak pernah melihat namanya.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=

# Batas perintah mode cloud per perangkat per hari (WIB)
AGENT_DAILY_QUOTA=50

# Suara cloud (POST /api/tts): membacakan jawaban Batur dengan suara neural Indonesia.
# TTS_ENABLED=false mematikannya; aplikasi otomatis memakai TTS bawaan Android.
TTS_ENABLED=true
TTS_DAILY_QUOTA=200
TTS_MAX_CONCURRENT=4
# TTS_CACHE_DIR=/opt/batur/tts-cache
TTS_CACHE_MAX_FILES=1000

# Versi APK terbaru untuk banner update di aplikasi (GET /api/app/version)
APP_VERSION_CODE=2
APP_VERSION_NAME=1.1.0
APP_APK_URL=https://github.com/cahyohackids/Batur/releases/latest
APP_RELEASE_NOTES="Batur 1.1.0"
