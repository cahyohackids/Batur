<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Sama dengan backup_rules.xml, berlaku untuk cadangan cloud dan pindah perangkat. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="model_downloads.xml" />
        <exclude domain="sharedpref" path="model_meta.xml" />
        <exclude domain="external" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="model_downloads.xml" />
        <exclude domain="sharedpref" path="model_meta.xml" />
        <exclude domain="external" path="models/" />
    </device-transfer>
</data-extraction-rules>
