<?xml version="1.0" encoding="utf-8"?>
<!-- Build release hanya boleh HTTPS. Build debug punya override di src/debug yang mengizinkan
     HTTP ke backend lokal (emulator 10.0.2.2 atau IP laptop di hotspot). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
